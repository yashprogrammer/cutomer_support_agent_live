# ── LLM (required) ────────────────────────────────────────────────────────────
# Get your free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.2

# ── Embeddings: choose ONE provider (required for Mem0 + RAG) ─────────────────
# Option A – Google Gemini (recommended, free tier available)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

# Option B – OpenAI
# OPENAI_API_KEY=your_openai_api_key_here

# Option C – Local HuggingFace (no API key, slower)
# ENABLE_LOCAL_EMBEDDINGS=true

# ── Storage paths (defaults work out-of-the-box) ──────────────────────────────
# DB_PATH=data/support.db
# CHROMA_RAG_DIR=data/chroma_rag
# CHROMA_MEM0_DIR=data/chroma_mem0
# KNOWLEDGE_BASE_DIR=knowledge_base

# ── Server ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_API_URL=http://localhost:8000
