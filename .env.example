# Core LLM settings
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Optional embedding providers for Mem0 / Chroma
GOOGLE_API_KEY=
OPENAI_API_KEY=
ENABLE_LOCAL_EMBEDDINGS=false

# Safety and tracing
GUARDRAILS_ENABLED=true
TRACER_ENABLED=true
TRACER_DIR=data/traces

# Guardrails AI Hub token (free key from https://hub.guardrailsai.com)
# Required to install hub validators: detect_pii, toxic_language, restrict_to_topic
GUARDRAILS_API_KEY=

# App URLs
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_API_URL=http://localhost:8000
